# Runtime
NODE_ENV=development
PORT=8080
ORIGIN=http://localhost:8080

# Database
# The internal database name remains unchanged for now to avoid accidental data loss.
DATABASE_URI=mongodb://database/wintrchess

# Authentication
# Replace with a long, random value. Never commit the real secret.
AUTH_SECRET=replace-with-a-long-random-secret

# Optional Google OAuth login
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# Analysis and Archive limits
ANALYSIS_SESSION_ACTIONS=80
MAXIMUM_ARCHIVE_SIZE=50

# Optional internal administration
INTERNAL_PASSWORD=

# Transactional email delivery (Brevo SMTP)
# Use the SMTP login and SMTP key shown under Brevo > SMTP & API.
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM_NAME=NexoChess
EMAIL_FROM_ADDRESS=contact@nexochess.com
EMAIL_REPLY_TO=contact@nexochess.com

# Public source-code destination used by /source.
# The client also falls back to this repository if the variable is omitted.
SOURCE_CODE_URL=https://github.com/ManuG155/nexochess

# Optional analytics and advertising. Leave blank while disabled.
ANALYTICS_MEASUREMENT_ID=
ADS_PUBLISHER_ID=

# Production values should use:
# NODE_ENV=production
# ORIGIN=https://www.nexochess.com
# SOURCE_CODE_URL=https://github.com/ManuG155/nexochess
#
# Google OAuth production redirect URI:
# https://www.nexochess.com/auth/account/callback/google
