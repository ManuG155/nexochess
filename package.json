{
    "workspaces": [
        "./shared",
        "./server",
        "./client"
    ],
    "scripts": {
        "start": "node server/dist/index.js",
        "build": "npm run build --workspaces --if-present",
        "build:cloudflare": "npm run build -w shared && npm run build -w client && node scripts/build-cloudflare.mjs",
        "build:cloudflare:production": "npm run build -w shared && npm run build -w client && node scripts/build-cloudflare.mjs --puzzle-origin https://nexochess-puzzle-data-production.manuel-garcia-villaescusa.workers.dev",
        "prepare:cloudflare:production": "node scripts/prepare-cloudflare-production.mjs",
        "verify:cloudflare:production": "node scripts/verify-cloudflare-production.mjs",
        "verify:deployment:staging": "node scripts/verify-cloudflare-deployment.mjs --environment staging",
        "verify:deployment:production": "node scripts/verify-cloudflare-deployment.mjs --environment production",
        "verify:puzzle-data": "node scripts/verify-puzzle-data.mjs",
        "verify:account-email": "node scripts/verify-account-email.mjs",
        "verify:consent-contact": "node scripts/verify-consent-contact.mjs",
        "verify:security": "node scripts/verify-security-hardening.mjs",
        "verify:public-api": "node scripts/verify-public-api-security.mjs",
        "verify:operations": "node scripts/verify-cloudflare-operations.mjs",
        "verify:canonical": "node scripts/verify-canonical-domain.mjs",
        "audit:dependencies": "npm audit --audit-level=high",
        "deploy:staging": "node scripts/cloudflare-operations.mjs deploy --environment staging",
        "deploy:production": "node scripts/cloudflare-operations.mjs deploy --environment production",
        "backup:d1:staging": "node scripts/cloudflare-operations.mjs backup --environment staging",
        "backup:d1:production": "node scripts/cloudflare-operations.mjs backup --environment production",
        "recovery:staging": "node scripts/cloudflare-operations.mjs recovery-point --environment staging",
        "recovery:production": "node scripts/cloudflare-operations.mjs recovery-point --environment production",
        "config:staging": "node scripts/cloudflare-operations.mjs snapshot-config --environment staging",
        "config:production": "node scripts/cloudflare-operations.mjs snapshot-config --environment production",
        "monitor:staging": "node scripts/cloudflare-operations.mjs monitor --environment staging",
        "monitor:production": "node scripts/cloudflare-operations.mjs monitor --environment production",
        "bbuild": "npm run build -w shared && npm run build -w server",
        "dev": "npm run build && npm start",
        "lint": "eslint .",
        "check:puzzles": "node scripts/check-puzzle-backend.mjs",
        "check:translations": "node scripts/check-translations.mjs",
        "check:repository": "node scripts/check-repository.mjs",
        "check": "npm run check:translations && npm run check:repository && npm run check:puzzles && npm run verify:account-email && npm run verify:consent-contact && npm run verify:security && npm run verify:public-api && npm run verify:operations && npm run verify:canonical && npm run check -w client && npm run check -w server",
        "verify": "npm run check && npm run build",
        "import:puzzles": "node scripts/import-lichess-puzzles.mjs",
        "export:puzzles:static": "node scripts/export-puzzles-static.mjs"
    },
    "devDependencies": {
        "@stylistic/eslint-plugin-ts": "^2.1.0",
        "eslint": "^8.57.1",
        "typescript": "^5.4.5",
        "typescript-eslint": "^7.12.0",
        "webpack-bundle-analyzer": "^4.10.2"
    }
}
